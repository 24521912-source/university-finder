{
  "apps": [
    {
      "name": "unimatch-api",
      "cwd": "./backend",
      "script": "src/server.js",
      "exec_mode": "cluster",
      "instances": 2,
      "autorestart": true,
      "watch": false,
      "ignore_watch": ["node_modules", "public", "logs"],
      "max_memory_restart": "300M",
      "error_file": "./logs/api-error.log",
      "out_file": "./logs/api-out.log",
      "merge_logs": true,
      "time": true,
      "wait_ready": true,
      "listen_timeout": 15000,
      "kill_timeout": 5000,
      "env_development": {
        "NODE_ENV": "development",
        "PORT": 5000,
        "MONGODB_DB_NAME": "unimatch_hcmc",
        "APP_URL": "http://localhost:5173"
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 5000,
        "MONGODB_DB_NAME": "unimatch_hcmc",
        "APP_URL": "https://unimatch.tech"
      }
    },
    {
      "name": "unimatch-web",
      "script": "serve",
      "instances": 1,
      "autorestart": true,
      "time": true,
      "env": {
        "PM2_SERVE_PATH": "./frontend/dist",
        "PM2_SERVE_PORT": 8080,
        "PM2_SERVE_SPA": "true",
        "PM2_SERVE_HOMEPAGE": "/index.html"
      }
    }
  ]
}
