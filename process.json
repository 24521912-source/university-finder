{
  "apps": [
    {
      "name": "unimatch-api",
      "cwd": "./backend",
      "script": "src/server.js",
      "exec_mode": "cluster",
      "instances": 2,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "300M",
      "kill_timeout": 5000,
      "time": true,
      "env": {
        "NODE_ENV": "development",
        "PORT": 5000
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 5000
      }
    },
    {
      "name": "unimatch-web",
      "script": "serve",
      "instances": 1,
      "autorestart": true,
      "time": true,
      "env": {
        "PM2_SERVE_PATH": "./frontend/dist",
        "PM2_SERVE_PORT": 8080,
        "PM2_SERVE_SPA": "true",
        "PM2_SERVE_HOMEPAGE": "/index.html"
      }
    }
  ]
}
