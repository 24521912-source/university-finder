PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=unimatch_hcmc
JWT_SECRET=<chuoi-ngau-nhien-dai-de-ky-token-dang-nhap>

# Quên mật khẩu — địa chỉ trang web (frontend) để tạo link trong email
APP_URL=http://localhost:5173
# Gửi email qua Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (16 ký tự) tại
# https://myaccount.google.com/apppasswords. Để trống khi chạy local: thư được in ra terminal.
SMTP_USER=
SMTP_PASS=
# Tùy chọn (mặc định Gmail): SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  MAIL_FROM="UniMatch HCMC <ten@gmail.com>"
